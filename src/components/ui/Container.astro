---
interface Props {
  width?: 'default' | 'narrow';
}

const { width = 'default' } = Astro.props;
---

<div class:list={['container', width === 'narrow' && 'container--narrow']}>
  <slot />
</div>

<style>
  .container {
    --container-max-width: var(--breakpoint-xl);
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .container--narrow {
    --container-max-width: var(--breakpoint-md);
  }
</style>
