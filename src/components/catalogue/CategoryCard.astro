---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import cableManagementIcon from '@/assets/categories/cable-management.svg';
import cablesIcon from '@/assets/categories/cables.svg';
import electricalConsumablesIcon from '@/assets/categories/electrical-consumables.svg';
import enclosuresIcon from '@/assets/categories/enclosures.svg';
import renewableEnergyIcon from '@/assets/categories/renewable-energy-equipment.svg';
import switchgearIcon from '@/assets/categories/switchgear.svg';
import fallbackIcon from '@/assets/brand/favicon.svg';
import type { CategoryCard as CategoryCardViewModel } from '@/lib/catalogue/categories';

interface Props {
  slug: CategoryCardViewModel['slug'];
  name: CategoryCardViewModel['name'];
  summary: CategoryCardViewModel['summary'];
  href: CategoryCardViewModel['href'];
  cardImage?: CategoryCardViewModel['cardImage'];
  /**
   * The card's heading level, because the card's depth depends on its caller.
   * On `/products/` the cards sit directly under the page `h1`, so `h2` is
   * right. On the home page they sit under a section `h2`, where a second `h2`
   * would flatten the hierarchy. Axe does not catch this — it only reports
   * *skipped* levels — so the caller has to be explicit.
   */
  headingLevel?: 2 | 3;
}

const { slug, name, summary, href, cardImage, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const categoryIcons: Record<string, ImageMetadata> = {
  'cable-management': cableManagementIcon,
  cables: cablesIcon,
  'electrical-consumables': electricalConsumablesIcon,
  'enclosures-and-combiners': enclosuresIcon,
  'renewable-energy-equipment': renewableEnergyIcon,
  'switchgear-and-components': switchgearIcon,
};
const icon = categoryIcons[slug] ?? fallbackIcon;
---

<a
  class:list={['category-card', cardImage && 'category-card--photo']}
  data-category-slug={slug}
  href={href}
>
  {
    cardImage ? (
      <span class="category-card__photo" aria-hidden="true">
        <Image
          src={cardImage}
          alt=""
          widths={[480, 720, 960]}
          sizes="(min-width: 80rem) 384px, (min-width: 64rem) 30vw, (min-width: 48rem) 46vw, calc(100vw - 32px)"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </span>
    ) : (
      <span class="category-card__visual" aria-hidden="true">
        <img
          src={icon.src}
          width={icon.width}
          height={icon.height}
          alt=""
          decoding="async"
        />
      </span>
    )
  }
  <span class="category-card__body">
    <Heading class="category-card__title">{name}</Heading>
    <span class="category-card__summary">{summary}</span>
    <span class="category-card__cue" aria-hidden="true">
      View range <span>→</span>
    </span>
  </span>
</a>

<style>
  .category-card {
    position: relative;
    display: flex;
    overflow: hidden;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-background);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .category-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 0.25rem;
    background: linear-gradient(
      90deg,
      var(--color-brand-teal),
      var(--color-brand-green)
    );
    content: '';
    /* Drawn full width at rest. It was a scaleX(0.35) stub that only completed
       on hover, which put the brand gradient on a card for the fraction of a
       visit a pointer happened to be over it — and never at all on a touch
       device. Being decorative and graphic-only, it carries no contrast floor,
       so there is no reason to hide it. Deliberately no transform or
       transition here: a full-width rule has nothing left to animate. */
  }

  .category-card--photo {
    padding: 0;
  }

  .category-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .category-card__photo {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    flex: none;
    background: var(--color-accent-tint);
  }

  .category-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 240ms ease;
  }

  .category-card:hover .category-card__photo :global(img) {
    transform: scale(1.025);
  }

  .category-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    color: inherit;
    transform: translateY(-0.15rem);
  }

  .category-card__visual {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    flex: none;
    background: linear-gradient(
      145deg,
      var(--color-accent-tint),
      var(--color-surface)
    );
    place-items: center;
  }

  .category-card__visual img {
    width: 4.5rem;
    height: 4.5rem;
  }

  .category-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .category-card__title,
  .category-card__summary {
    overflow-wrap: anywhere;
  }

  .category-card__title {
    font-size: var(--font-size-xl);
  }

  .category-card__summary {
    display: block;
  }

  .category-card__cue {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .category-card__cue span {
    font-size: var(--font-size-lg);
    line-height: 1;
    transition: transform 160ms ease;
  }

  .category-card:hover .category-card__cue span {
    transform: translateX(0.2rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card__photo :global(img),
    .category-card__cue span {
      transition: none;
    }

    .category-card:hover,
    .category-card:hover .category-card__photo :global(img),
    .category-card:hover .category-card__cue span {
      transform: none;
    }
  }
</style>
