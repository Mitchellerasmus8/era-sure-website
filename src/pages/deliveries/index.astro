---
import { getCollection } from 'astro:content';
import DeliveryHighlightCard from '@/components/deliveries/DeliveryHighlightCard.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  filterPublishableDeliveries,
  sortDeliveryHighlights,
  validateDeliveryHighlights,
} from '@/lib/deliveries/highlights';
import { getBreadcrumbs } from '@/lib/navigation/breadcrumbs';
import { getPrimaryCta } from '@/lib/navigation/cta';
import { siteConfig } from '@/site.config';

const entries = await getCollection('deliveries');
const visible = filterPublishableDeliveries(entries);
validateDeliveryHighlights(visible);
const highlights = sortDeliveryHighlights(visible);

if (highlights.length === 0) {
  return Astro.redirect('/');
}

const breadcrumbs = getBreadcrumbs('/deliveries/');
const primaryCta = getPrimaryCta();
---

<BaseLayout
  title={`Supply and delivery highlights | ${siteConfig.displayName}`}
  description="View recent equipment supply and delivery highlights from Era-Sure Renewables, showcasing consolidated orders delivered to solar and electrical contractors."
  breadcrumbs={breadcrumbs}
>
  <Section surface="muted" headingId="deliveries-heading">
    <Container width="narrow">
      <div class="deliveries-intro">
        <Eyebrow>Delivery record</Eyebrow>
        <h1 id="deliveries-heading">Recent equipment deliveries</h1>
        <p>
          Selected electrical and renewable-energy equipment orders delivered to
          projects across South Africa.
        </p>
      </div>
    </Container>
  </Section>

  <Section surface="default" headingId="delivery-list-heading">
    <Container>
      <div class="section-heading">
        <Eyebrow>Delivery highlights</Eyebrow>
        <h2 id="delivery-list-heading">Recent orders</h2>
      </div>
      <ul class="delivery-grid">
        {
          highlights.map((entry) => (
            <li>
              <DeliveryHighlightCard entry={entry} headingLevel={3} />
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {
    primaryCta && (
      <Section surface="inverted" headingId="delivery-cta-heading">
        <Container width="narrow">
          <div class="delivery-cta">
            <Eyebrow>Quotations</Eyebrow>
            <h2 id="delivery-cta-heading">
              Request pricing for a similar order
            </h2>
            <p>
              Submit a product list or bill of quantities for current pricing,
              availability and delivery arrangements.
            </p>
            <div>
              <Button href={primaryCta.href}>{primaryCta.label}</Button>
            </div>
          </div>
        </Container>
      </Section>
    )
  }
</BaseLayout>

<style>
  .deliveries-intro,
  .delivery-cta {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .section-heading {
    max-width: var(--measure);
  }

  .delivery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .delivery-grid li {
    min-width: 0;
  }
</style>
