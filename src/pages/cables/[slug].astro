---
import { getCollection, type CollectionEntry } from 'astro:content';
import SpecTable from '@/components/catalogue/SpecTable.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assertUniqueSlugs } from '@/lib/catalogue/slugs';
import { formatSpecs } from '@/lib/catalogue/specs';
import { filterPublishedProducts } from '@/lib/catalogue/visibility';
import { getBreadcrumbs } from '@/lib/navigation/breadcrumbs';
import { getPrimaryCta } from '@/lib/navigation/cta';
import { buildProductStructuredData } from '@/lib/seo/structured-data';
import { siteConfig } from '@/site.config';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');
  const visibleProducts = filterPublishedProducts(allProducts);
  const cableProducts = visibleProducts.filter(
    (entry) => entry.data.category === 'cables',
  );

  assertUniqueSlugs(cableProducts);

  return cableProducts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'products'>;
}

const { entry } = Astro.props;
const rows = formatSpecs(entry.data);
// Pass the real product name; de-slugifying the URL would render
// "Solar Pv Cable 4mm2 Twin Core" instead of "Solar PV Cable 4 mm² Twin Core".
const breadcrumbs = getBreadcrumbs(`/cables/${entry.data.slug}/`, {
  currentLabel: entry.data.name,
});
const primaryCta = getPrimaryCta();
const productStructuredData = buildProductStructuredData(
  entry.data,
  siteConfig.siteUrl,
);
---

<BaseLayout
  title={entry.data.name}
  description={entry.data.summary}
  breadcrumbs={breadcrumbs}
  structuredData={productStructuredData}
>
  <Section surface="muted" headingId="product-heading">
    <Container width="narrow">
      <article class="product-content">
        <header class="product-content__header">
          <Eyebrow>Solar PV cable specification</Eyebrow>
          <h1 id="product-heading">{entry.data.name}</h1>
          <p class="product-content__summary">{entry.data.summary}</p>
        </header>
        <SpecTable rows={rows} />
        {
          entry.data.datasheetPath && (
            <p class="product-content__datasheet">
              <a href={entry.data.datasheetPath}>
                Download technical datasheet
              </a>
            </p>
          )
        }
        <p class="product-content__nav-links">
          <a href="/cables/">View all solar PV cables</a> ·{' '}
          <a href="/products/cables/">View cable supply highlights</a>
        </p>
      </article>
    </Container>
  </Section>

  {
    primaryCta && (
      <Section surface="inverted" headingId="product-cta-heading">
        <Container width="narrow">
          <div class="product-cta">
            <Eyebrow>Quotations</Eyebrow>
            <h2 id="product-cta-heading">
              Request pricing for {entry.data.name}
            </h2>
            <p>
              Submit your required quantities, lengths and delivery location for
              current pricing and availability.
            </p>
            <div>
              <Button href={primaryCta.href}>{primaryCta.label}</Button>
            </div>
          </div>
        </Container>
      </Section>
    )
  }
</BaseLayout>

<style>
  .product-content {
    min-width: 0;
  }

  .product-content__header {
    display: grid;
    gap: var(--space-3);
  }

  .product-content h1 {
    overflow-wrap: anywhere;
  }

  .product-content__summary {
    max-width: var(--measure);
    overflow-wrap: anywhere;
  }

  .product-content :global(.spec-table) {
    margin-block-start: var(--space-6);
  }

  .product-content__datasheet {
    margin-block-start: var(--space-5);
  }

  .product-content__nav-links {
    margin-block-start: var(--space-5);
    font-size: var(--font-size-sm);
  }

  .product-cta {
    display: grid;
    gap: var(--space-4);
  }
</style>
